# Copy this file to .env and fill in the keys on the server only.
OPENAI_API_KEY=
GEMINI_API_KEY=
# Optional OpenAI-compatible endpoint (leave empty for the default).
OPENAI_ENDPOINT=
OPENAI_MODEL=gpt-4.1-mini
# Defaults preserved from the supplied self_rag.py; adjust for your account.
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=90
EMBEDDING_BATCH_PAUSE_SECONDS=60
